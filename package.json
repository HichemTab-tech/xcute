{
  "name": "xcute-cli",
  "description": "Execute reusable command workflows from a single CLI.",
  "version": "0.11.0",
  "author": "Hichem Taboukouyout",
  "bin": {
    "xcute": "./bin/run.js"
  },
  "bugs": "https://github.com/HichemTab-tech/xcute/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "@oclif/core": "^5.0.0",
    "@oclif/plugin-help": "^7.0.0",
    "@oclif/plugin-plugins": "^6.0.1",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "execa": "^10.0.1",
    "strip-ansi": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^5.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.0",
    "chai": "^6.2.2",
    "eslint": "^10.1.0",
    "eslint-config-oclif": "^7.1.7",
    "eslint-config-prettier": "^10.1.8",
    "mocha": "^12.0.0",
    "oclif": "^5.0.1",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/HichemTab-tech/xcute",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "xcute",
    "dirname": "xcute",
    "commands": "./dist/commands",
    "hooks": {
      "command_not_found": "./dist/hooks/command_not_found"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " "
  },
  "repository": "HichemTab-tech/xcute",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "oclif manifest && oclif readme",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md",
    "bump": "node scripts/bumper.js"
  },
  "types": "dist/index.d.ts"
}
